{
 "checks": [
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "LENGTH_WORDS",
     "number": 3000,
     "scopes": [
      {
       "type": "body"
      }
     ]
    }
   ],
   "name": "Body ≤ 3,000 words",
   "note": "Not including abstract, tables, figures, acknowledgments, references, and online-only material. Counts every active section, Key Points included; the venue counts those separately."
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "LENGTH_WORDS",
     "number": 350,
     "scopes": [
      {
       "type": "abstract"
      }
     ]
    }
   ],
   "name": "Abstract ≤ 350 words"
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "metric": "CONTAINS",
     "scopes": [
      {
       "type": "abstract"
      }
     ],
     "text": "Importance"
    },
    {
     "metric": "CONTAINS",
     "scopes": [
      {
       "type": "abstract"
      }
     ],
     "text": "Objective"
    },
    {
     "metric": "CONTAINS",
     "scopes": [
      {
       "type": "abstract"
      }
     ],
     "text": "Data Sources"
    },
    {
     "metric": "CONTAINS",
     "scopes": [
      {
       "type": "abstract"
      }
     ],
     "text": "Study Selection"
    },
    {
     "metric": "CONTAINS",
     "scopes": [
      {
       "type": "abstract"
      }
     ],
     "text": "Data Extraction and Synthesis"
    },
    {
     "metric": "CONTAINS",
     "scopes": [
      {
       "type": "abstract"
      }
     ],
     "text": "Main Outcome"
    },
    {
     "metric": "CONTAINS",
     "scopes": [
      {
       "type": "abstract"
      }
     ],
     "text": "Results"
    },
    {
     "metric": "CONTAINS",
     "scopes": [
      {
       "type": "abstract"
      }
     ],
     "text": "Conclusions and Relevance"
    }
   ],
   "name": "Structured abstract headings",
   "note": "Importance; Objective; Data Sources; Study Selection; Data Extraction and Synthesis; Main Outcome(s) and Measure(s); Results; Conclusions and Relevance"
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "LENGTH_WORDS",
     "number": 100,
     "scopes": [
      {
       "name": "Key Points",
       "type": "section"
      }
     ]
    }
   ],
   "name": "Key Points ≤ 100 words",
   "note": "Three labelled parts before the abstract, 100 words or fewer in all: Question (1 sentence), Findings (1–2 sentences — the design and primary outcomes, significance stated without statistical test results), Meaning (1 sentence)."
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "metric": "CONTAINS",
     "scopes": [
      {
       "name": "Key Points",
       "type": "section"
      }
     ],
     "text": "Question"
    },
    {
     "metric": "CONTAINS",
     "scopes": [
      {
       "name": "Key Points",
       "type": "section"
      }
     ],
     "text": "Findings"
    },
    {
     "metric": "CONTAINS",
     "scopes": [
      {
       "name": "Key Points",
       "type": "section"
      }
     ],
     "text": "Meaning"
    }
   ],
   "name": "Key Points: Question, Findings, Meaning"
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "COUNT",
     "number": 75,
     "scopes": [
      {
       "type": "references"
      }
     ]
    }
   ],
   "name": "References ≤ 75",
   "note": "The venue expects 50–75."
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "COUNT",
     "number": 5,
     "scopes": [
      {
       "type": "figures"
      },
      {
       "type": "tables"
      }
     ]
    }
   ],
   "name": "Tables + figures ≤ 5"
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "LENGTH_CHARS",
     "number": 100,
     "scopes": [
      {
       "type": "title"
      }
     ]
    }
   ],
   "name": "Title ≤ 100 characters",
   "note": "Including spaces. Research reports and major articles 100; shorter article types 60."
  },
  {
   "combinator": "ANY",
   "conditions": [
    {
     "metric": "CONTAINS",
     "scopes": [
      {
       "type": "subtitle"
      }
     ],
     "text": "A Meta-analysis"
    }
   ],
   "name": "Subtitle names the study type",
   "note": "Expected: “A Meta-analysis”"
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": ">=",
     "metric": "FONT_SIZE",
     "number": 10.0,
     "scopes": [
      {
       "type": "export"
      }
     ]
    },
    {
     "comparator": "<=",
     "metric": "FONT_SIZE",
     "number": 12.0,
     "scopes": [
      {
       "type": "export"
      }
     ]
    }
   ],
   "name": "Export font 10–12 pt"
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": ">=",
     "metric": "LINE_SPACING",
     "number": 2.0,
     "scopes": [
      {
       "type": "export"
      }
     ]
    }
   ],
   "name": "Export double-spaced"
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "==",
     "metric": "STRUCTURE",
     "number": 1,
     "scopes": []
    }
   ],
   "name": "Sections match the journal's structure",
   "note": "Every section marked required in the structure file must be present and non-empty"
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "EXISTS",
     "number": 0,
     "scopes": [
      {
       "type": "coverLetter"
      }
     ]
    }
   ],
   "name": "Cover letter present",
   "note": "Complete contact information for the corresponding author and whether the authors have published, posted, or submitted any related papers from the same study."
  },
  {
   "conditions": [],
   "manual": true,
   "name": "PRISMA (or MOOSE) followed; flow diagram in the online supplement",
   "note": "Tick once verified by hand"
  },
  {
   "conditions": [],
   "manual": true,
   "name": "Data Sharing Statement supplied",
   "note": "Says whether the data will be shared and, if so, what, when, where and how; published as an online supplement."
  },
  {
   "conditions": [],
   "manual": true,
   "name": "Acknowledgment complete: contributions, data access statement, disclosures, funding and its role",
   "note": "Tick once verified by hand"
  },
  {
   "conditions": [],
   "manual": true,
   "name": "Conflict of interest disclosures for every author",
   "note": "Complete disclosure of all relevant financial relationships; authors with none say so."
  },
