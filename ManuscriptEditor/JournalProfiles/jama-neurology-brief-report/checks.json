{
 "checks": [
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "LENGTH_WORDS",
     "number": 1200,
     "scopes": [
      {
       "type": "body"
      }
     ]
    }
   ],
   "name": "Body ≤ 1,200 words (recommended)",
   "note": "Recommended length: 1200 words, not including abstract, tables, figures, acknowledgments, references, and online-only material. Counts every active section, Key Points included; the venue counts those separately."
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "LENGTH_WORDS",
     "number": 100,
     "scopes": [
      {
       "name": "Key Points",
       "type": "section"
      }
     ]
    }
   ],
   "name": "Key Points ≤ 100 words",
   "note": "Three labelled parts before the abstract, 100 words or fewer in all: Question (1 sentence), Findings (1–2 sentences — the design and primary outcomes, significance stated without statistical test results), Meaning (1 sentence)."
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "metric": "CONTAINS",
     "scopes": [
      {
       "name": "Key Points",
       "type": "section"
      }
     ],
     "text": "Question"
    },
    {
     "metric": "CONTAINS",
     "scopes": [
      {
       "name": "Key Points",
       "type": "section"
      }
     ],
     "text": "Findings"
    },
    {
     "metric": "CONTAINS",
     "scopes": [
      {
       "name": "Key Points",
       "type": "section"
      }
     ],
     "text": "Meaning"
    }
   ],
   "name": "Key Points: Question, Findings, Meaning"
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "COUNT",
     "number": 15,
     "scopes": [
      {
       "type": "references"
      }
     ]
    }
   ],
   "name": "References ≤ 15"
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "COUNT",
     "number": 3,
     "scopes": [
      {
       "type": "figures"
      },
      {
       "type": "tables"
      }
     ]
    }
   ],
   "name": "Tables + figures ≤ 3"
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "LENGTH_CHARS",
     "number": 100,
     "scopes": [
      {
       "type": "title"
      }
     ]
    }
   ],
   "name": "Title ≤ 100 characters",
   "note": "Including spaces. Research reports and major articles 100; shorter article types 60."
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": ">=",
     "metric": "FONT_SIZE",
     "number": 10.0,
     "scopes": [
      {
       "type": "export"
      }
     ]
    },
    {
     "comparator": "<=",
     "metric": "FONT_SIZE",
     "number": 12.0,
     "scopes": [
      {
       "type": "export"
      }
     ]
    }
   ],
   "name": "Export font 10–12 pt"
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": ">=",
     "metric": "LINE_SPACING",
     "number": 2.0,
     "scopes": [
      {
       "type": "export"
      }
     ]
    }
   ],
   "name": "Export double-spaced"
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "==",
     "metric": "STRUCTURE",
     "number": 1,
     "scopes": []
    }
   ],
   "name": "Sections match the journal's structure",
   "note": "Every section marked required in the structure file must be present and non-empty"
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "EXISTS",
     "number": 0,
     "scopes": [
      {
       "type": "coverLetter"
      }
     ]
    }
   ],
   "name": "Cover letter present",
   "note": "Complete contact information for the corresponding author and whether the authors have published, posted, or submitted any related papers from the same study."
  },
  {
   "conditions": [],
   "manual": true,
   "name": "Data Sharing Statement supplied",
   "note": "Says whether the data will be shared and, if so, what, when, where and how; published as an online supplement."
  },
  {
   "conditions": [],
   "manual": true,
   "name": "Reporting guideline followed and checklist attached",
   "note": "The EQUATOR guideline for the study design (CONSORT, STROBE, PRISMA, STARD, …), named in the Methods."
  },
  {
   "conditions": [],
   "manual": true,
   "name": "Acknowledgment complete: contributions, data access statement, disclosures, funding and its role",
   "note": "Tick once verified by hand"
  },
  {
   "conditions": [],
   "manual": true,
   "name": "Conflict of interest disclosures for every author",
   "note": "Complete disclosure of all relevant financial relationships; authors with none say so."
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "EXISTS",
     "number": 0,
     "scopes": [
      {
       "name": "Introduction",
       "type": "section"
      }
     ]
    }
   ],
   "name": "Introduction section present",
   "note": "Required by this journal's structure."
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "EXISTS",
     "number": 0,
     "scopes": [
      {
       "name": "Methods",
       "type": "section"
      }
     ]
    }
   ],
   "name": "Methods section present",
   "note": "Required by this journal's structure."
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "EXISTS",
     "number": 0,
     "scopes": [
      {
       "name": "Results",
       "type": "section"
      }
     ]
    }
   ],
   "name": "Results section present",
   "note": "Required by this journal's structure."
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "EXISTS",
     "number": 0,
     "scopes": [
      {
       "name": "Discussion",
       "type": "section"
      }
     ]
    }
   ],
   "name": "Discussion section present",
   "note": "Required by this journal's structure."
  }
 ]
}
