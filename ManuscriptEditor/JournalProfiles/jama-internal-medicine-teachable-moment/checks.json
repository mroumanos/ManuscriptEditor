{
 "checks": [
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "LENGTH_WORDS",
     "number": 800,
     "scopes": [
      {
       "type": "body"
      }
     ]
    }
   ],
   "name": "Body ≤ 800 words",
   "note": "Manuscripts should not exceed 800 words and 5 references."
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "LENGTH_WORDS",
     "number": 0,
     "scopes": [
      {
       "type": "abstract"
      }
     ]
    }
   ],
   "name": "No abstract",
   "note": "This article type carries no abstract — leave the Abstract empty or deactivate it."
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "COUNT",
     "number": 5,
     "scopes": [
      {
       "type": "references"
      }
     ]
    }
   ],
   "name": "References ≤ 5"
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "COUNT",
     "number": 1,
     "scopes": [
      {
       "type": "figures"
      },
      {
       "type": "tables"
      }
     ]
    }
   ],
   "name": "Tables + figures ≤ 1"
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "COUNT",
     "number": 3,
     "scopes": [
      {
       "type": "authors"
      }
     ]
    }
   ],
   "name": "Authors ≤ 3"
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "LENGTH_CHARS",
     "number": 60,
     "scopes": [
      {
       "type": "title"
      }
     ]
    }
   ],
   "name": "Title ≤ 60 characters",
   "note": "Including spaces. Research reports and major articles 100; shorter article types 60."
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": ">=",
     "metric": "FONT_SIZE",
     "number": 10.0,
     "scopes": [
      {
       "type": "export"
      }
     ]
    },
    {
     "comparator": "<=",
     "metric": "FONT_SIZE",
     "number": 12.0,
     "scopes": [
      {
       "type": "export"
      }
     ]
    }
   ],
   "name": "Export font 10–12 pt"
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": ">=",
     "metric": "LINE_SPACING",
     "number": 2.0,
     "scopes": [
      {
       "type": "export"
      }
     ]
    }
   ],
   "name": "Export double-spaced"
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "==",
     "metric": "STRUCTURE",
     "number": 1,
     "scopes": []
    }
   ],
   "name": "Sections match the journal's structure",
   "note": "Every section marked required in the structure file must be present and non-empty"
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "EXISTS",
     "number": 0,
     "scopes": [
      {
       "type": "coverLetter"
      }
     ]
    }
   ],
   "name": "Cover letter present",
   "note": "Complete contact information for the corresponding author and whether the authors have published, posted, or submitted any related papers from the same study."
  },
  {
   "conditions": [],
   "manual": true,
   "name": "Patient permission form signed and submitted",
   "note": "The JAMA Network Patient Permission form, for any identifiable patient."
  },
  {
   "conditions": [],
   "manual": true,
   "name": "Conflict of interest disclosures for every author",
   "note": "Complete disclosure of all relevant financial relationships; authors with none say so."
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "EXISTS",
     "number": 0,
     "scopes": [
      {
       "name": "Story From the Front Lines",
       "type": "section"
      }
     ]
    }
   ],
   "name": "Story From the Front Lines section present",
   "note": "Required by this journal's structure."
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "EXISTS",
     "number": 0,
     "scopes": [
      {
       "name": "Teachable Moment",
       "type": "section"
      }
     ]
    }
   ],
   "name": "Teachable Moment section present",
   "note": "Required by this journal's structure."
  }
 ]
}
