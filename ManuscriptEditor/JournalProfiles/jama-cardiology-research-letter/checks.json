    {
     "comparator": "<=",
     "metric": "FONT_SIZE",
     "number": 12.0,
     "scopes": [
      {
       "type": "export"
      }
     ]
    }
   ],
   "name": "Export font 10–12 pt"
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": ">=",
     "metric": "LINE_SPACING",
     "number": 2.0,
     "scopes": [
      {
       "type": "export"
      }
     ]
    }
   ],
   "name": "Export double-spaced"
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "==",
     "metric": "STRUCTURE",
     "number": 1,
     "scopes": []
    }
   ],
   "name": "Sections match the journal's structure",
   "note": "Every section marked required in the structure file must be present and non-empty"
