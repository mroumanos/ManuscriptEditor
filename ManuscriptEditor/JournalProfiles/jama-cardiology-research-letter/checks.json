{
 "checks": [
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "LENGTH_WORDS",
     "number": 800,
     "scopes": [
      {
       "type": "body"
      }
     ]
    }
   ],
   "name": "Body ≤ 800 words",
   "note": "Not more than 800 words of text."
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "LENGTH_WORDS",
     "number": 0,
     "scopes": [
      {
       "type": "abstract"
      }
     ]
    }
   ],
   "name": "No abstract",
   "note": "This article type carries no abstract — leave the Abstract empty or deactivate it."
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "COUNT",
     "number": 10,
     "scopes": [
      {
       "type": "references"
      }
     ]
    }
   ],
   "name": "References ≤ 10"
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "COUNT",
     "number": 2,
     "scopes": [
      {
       "type": "figures"
      },
      {
       "type": "tables"
      }
     ]
    }
   ],
   "name": "Tables + figures ≤ 2"
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": "<=",
     "metric": "LENGTH_CHARS",
     "number": 60,
     "scopes": [
      {
       "type": "title"
      }
     ]
    }
   ],
   "name": "Title ≤ 60 characters",
   "note": "Including spaces. Research reports and major articles 100; shorter article types 60."
  },
  {
   "combinator": "ALL",
   "conditions": [
    {
     "comparator": ">=",
     "metric": "FONT_SIZE",
     "number": 10.0,
     "scopes": [
      {
       "type": "export"
      }
     ]
