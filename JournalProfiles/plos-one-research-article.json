{
  "articleType": "Research Article",
  "checks": [
    {
      "combinator": "ALL",
      "conditions": [
        {
          "comparator": "<=",
          "metric": "LENGTH_WORDS",
          "number": 300,
          "scopes": [
            {
              "kind": "abstract"
            }
          ]
        }
      ],
      "name": "Abstract \u2264 300 words"
    },
    {
      "combinator": "ALL",
      "conditions": [
        {
          "metric": "EXISTS",
          "scopes": [
            {
              "kind": "section",
              "name": "Methods"
            },
            {
              "kind": "section",
              "name": "Results"
            }
          ]
        }
      ],
      "name": "Methods and Results present"
    },
    {
      "conditions": [],
      "manual": true,
      "name": "Data availability statement required",
      "note": "Tick once the statement is in the submission form"
    }
  ],
  "id": "plos-one-research-article",
  "name": "PLOS ONE",
  "origin": "bundled",
  "originURL": "https://github.com/mroumanos/ManuscriptEditor/blob/main/JournalProfiles/plos-one-research-article.json",
  "sourceRequirements": {
    "summary": "No length limit on the body, but the abstract is capped at 300 words and must be unstructured. Title, Authors, Abstract, Introduction, Materials and Methods, Results, Discussion, Conclusions. Data availability statement required. Figures as separate high-resolution files (\u2265300 DPI).",
    "url": "https://journals.plos.org/plosone/s/submission-guidelines"
  }
}
